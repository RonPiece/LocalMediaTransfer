<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semantic WinUI brushes follow light, dark, and high-contrast themes. -->
    <StaticResource x:Key="MetricSpeedBrush" ResourceKey="SystemFillColorAttentionBrush" />
    <StaticResource x:Key="MetricFilesBrush" ResourceKey="SystemFillColorSuccessBrush" />
    <StaticResource x:Key="MetricDurationBrush" ResourceKey="SystemFillColorCautionBrush" />
    <StaticResource x:Key="MetricTotalBrush" ResourceKey="AccentFillColorDefaultBrush" />

    <Style x:Key="LmtCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="LmtSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LmtSectionSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="LmtCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LmtCardDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="Margin" Value="0,4,0,12" />
    </Style>

    <Style x:Key="LmtWarningInfoBarStyle" TargetType="InfoBar">
        <Setter Property="Severity" Value="Warning" />
    </Style>
</ResourceDictionary>
