<Window
    x:Class="LocalMediaTransfer.GUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalMediaTransfer.GUI"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Local Media Transfer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" ActualThemeChanged="RootGrid_ActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TestEnvironmentBanner"
                Grid.Row="0"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                Padding="12,7"
                Visibility="Collapsed">
            <TextBlock Text="TEST ENVIRONMENT — isolated storage and test ports"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </Border>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="641"
                        ExpandedModeThresholdWidth="1008"
                        OpenPaneLength="160"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Receive" Tag="Receive" Icon="Download" />
                <NavigationViewItem Content="Send" Tag="Send" Icon="Upload" />
                <NavigationViewItem Content="Activity" Tag="Activity" Icon="Clock" />
                <NavigationViewItem Content="Network" Tag="Network" Icon="Globe" />
                <NavigationViewItem Content="Security" Tag="Security" Icon="ProtectedDocument" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About" Icon="Help" />
                <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Grid x:Name="StatusIndicatorContainer"
                      Height="32"
                      Margin="8,6,8,10">
                    <StackPanel x:Name="StatusIndicatorPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="10"
                                 Height="10"
                                 Fill="{ThemeResource SystemFillColorNeutralBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="Server Stopped"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />

        </NavigationView>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        Grid.Row="1"
                        ToolTipText="Local Media Transfer"
                        IconSource="/Assets/Icons/TrayIcon.ico"
                        MenuActivation="LeftOrRightClick"
                        DoubleClickCommand="{x:Bind ShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open" Command="{x:Bind ShowWindowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Command="{x:Bind ExitApplicationCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>
