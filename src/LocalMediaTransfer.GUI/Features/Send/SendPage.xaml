<Page
    x:Class="LocalMediaTransfer.GUI.Features.Send.SendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RootPanel" Padding="16,16,16,24" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Send" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Send files securely to another Local Media Transfer Windows app"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="True" Severity="Informational"
                     Title="Ready to find a receiver"
                     Message="Both computers must be on the same private network." />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="1. Choose a receiver" FontWeight="SemiBold" />
                    <StackPanel x:Name="ReceiverActions" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ScanButton" Content="Scan nearby" Click="Scan_Click"
                                AutomationProperties.Name="Scan for nearby Windows receivers" />
                        <Button Content="Enter address manually" Click="ManualAddress_Click"
                                AutomationProperties.Name="Enter receiver IPv4 address manually" />
                        <Button x:Name="ForgetButton" Content="Forget" Click="Forget_Click"
                                IsEnabled="False" />
                    </StackPanel>
                    <ListView x:Name="ReceiverList" SelectionChanged="ReceiverList_SelectionChanged"
                              SelectionMode="Single" MaxHeight="250"
                              AutomationProperties.Name="Available and remembered receivers">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4" Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="ConnectButton" Content="Pair or connect" Click="Connect_Click"
                            IsEnabled="False" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="2. Choose files" FontWeight="SemiBold" />
                    <StackPanel x:Name="FileActions" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ChooseFilesButton" Content="Choose files" Click="ChooseFiles_Click"
                                IsEnabled="False" AutomationProperties.Name="Choose files to send" />
                        <Button x:Name="ClearFilesButton" Content="Clear" Click="ClearFiles_Click"
                                IsEnabled="False" />
                    </StackPanel>
                    <TextBlock x:Name="SelectionSummary" Text="No files selected"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="FilesList" MaxHeight="250" SelectionMode="None"
                              AutomationProperties.Name="Selected files">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="3" Content="Remove" Tag="{Binding FileId}"
                                            Click="RemoveFile_Click"
                                            AutomationProperties.Name="Remove selected file" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <CheckBox x:Name="SkipDuplicatesCheckBox" Content="Skip identical files"
                              IsChecked="True" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="3. Request approval and send" FontWeight="SemiBold" />
                    <ProgressBar x:Name="TransferProgress" Minimum="0" Maximum="100" Value="0"
                                 AutomationProperties.Name="Outbound transfer progress"
                                 AutomationProperties.HelpText="Percentage of selected files completed or skipped" />
                    <TextBlock x:Name="ProgressText" Text="Not started" TextWrapping="Wrap" />
                    <StackPanel x:Name="TransferActions" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SendButton" Content="Request approval and send"
                                Click="Send_Click" IsEnabled="False" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                                IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
