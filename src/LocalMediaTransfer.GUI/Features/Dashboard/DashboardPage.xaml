<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LocalMediaTransfer.GUI.Features.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    SizeChanged="Page_SizeChanged">

    <ScrollViewer x:Name="PageScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid x:Name="RootLayout"
              Padding="16,16,16,24"
              MinWidth="{Binding ElementName=PageScrollViewer, Path=ViewportWidth}"
              HorizontalAlignment="Stretch"
              RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Receive" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Choose how another device will connect to this computer"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Download" />
                        <TextBlock Text="Receive from a Windows computer"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="NativeReceiverStatus"
                               Text="Ready. Every incoming Windows transfer requires your approval."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="PendingApprovalsText"
                               Text="No approvals pending"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="NativeReceiverActions"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="PairWindowsButton"
                                Content="Pair a Windows computer"
                                Click="PairWindows_Click"
                                AutomationProperties.Name="Open Windows computer pairing for two minutes" />
                        <ToggleSwitch x:Name="NearbyReceiverToggle"
                                      Header="Allow nearby Windows discovery"
                                      Toggled="NearbyReceiverToggle_Toggled"
                                      AutomationProperties.Name="Allow nearby Windows computers to discover this receiver" />
                    </StackPanel>
                    <TextBlock Text="Requests wait in a secure approval queue. You can minimize the app while receiving."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Grid x:Name="ConnectionMethodsGrid"
                  Grid.Row="2"
                  ColumnSpacing="14"
                  RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ConnectionMethodsColumn1" Width="*" />
                    <ColumnDefinition x:Name="ConnectionMethodsColumn2" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="QrCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="18"
                        MinWidth="0">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="CellPhone" />
                            <TextBlock Text="Connect an iPhone"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Open Local Media Transfer on the iPhone and scan this pairing code."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image x:Name="QrCodeImage"
                               Width="210"
                               Height="210"
                               MinWidth="150"
                               MinHeight="150"
                               HorizontalAlignment="Center"
                               AutomationProperties.Name="iPhone pairing QR code" />
                        <TextBlock Text="This code is for the installed iPhone app. Browser users need the separate one-time link."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="SecondaryMethodsPanel"
                            Grid.Row="1"
                            Grid.Column="0"
                            Spacing="14">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="World" />
                                <TextBlock Text="Browser transfer"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Compatibility option for a device that cannot install the app."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="BrowserTransferButton"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Open browser transfer options">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Browser transfer options"
                                               HorizontalAlignment="Left" />
                                    <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout x:Name="BrowserTransferFlyout"
                                            Placement="Bottom"
                                            Opened="BrowserTransferFlyout_Opened">
                                        <StackPanel Width="370" MaxWidth="370" Spacing="12">
                                            <TextBlock Text="Browser transfer (compatibility)"
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Create a link only when another device is ready. It remains valid for up to five minutes and is consumed after its first successful use."
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <TextBlock x:Name="BrowserLinkStatusText"
                                                       Text="No active link · create one when you are ready to share"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="Browser link status and time remaining" />

                                            <StackPanel x:Name="ConnectionModePanel"
                                                        Spacing="6"
                                                        Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Connection type"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Button Padding="6,0"
                                                            MinWidth="24"
                                                            MinHeight="24"
                                                            Content="?"
                                                            ToolTipService.ToolTip="Which connection type should I use?"
                                                            Click="ConnectionModeHelp_Click"
                                                            AutomationProperties.Name="Explain browser connection types" />
                                                </StackPanel>
                                                <ComboBox x:Name="ConnectionModeSelector"
                                                          SelectedIndex="0"
                                                          HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Browser connection type">
                                                    <ComboBoxItem Content="Secure browser link (HTTPS)" />
                                                    <ComboBoxItem Content="Compatibility link (unencrypted HTTP)" />
                                                </ComboBox>
                                            </StackPanel>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="10,8">
                                                    <TextBlock x:Name="ConnectionUrl"
                                                               Text="No active browser link."
                                                               IsTextSelectionEnabled="True"
                                                               TextWrapping="Wrap"
                                                               AutomationProperties.Name="One-time browser transfer link" />
                                                </Border>
                                                <Button x:Name="CopyUrlBtn"
                                                        Grid.Column="1"
                                                        IsEnabled="False"
                                                        ToolTipService.ToolTip="Copy one-time browser link"
                                                        Click="CopyUrl_Click"
                                                        AutomationProperties.Name="Copy one-time browser link">
                                                    <SymbolIcon Symbol="Copy" />
                                                </Button>
                                            </Grid>

                                            <StackPanel x:Name="BrowserQrPanel"
                                                        Visibility="Collapsed"
                                                        Spacing="8"
                                                        HorizontalAlignment="Center">
                                                <Image x:Name="BrowserQrCodeImage"
                                                       Width="190"
                                                       Height="190"
                                                       AutomationProperties.Name="Browser transfer QR code containing the one-time link" />
                                                <TextBlock Text="Scan with the other device's camera"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <InfoBar Severity="Informational"
                                                     IsOpen="True"
                                                     IsClosable="False"
                                                     Message="Anyone with this complete link can use this transfer session until it expires. Share it only with the intended device." />

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="RefreshBrowserLinkButton"
                                                        Content="Create browser link"
                                                        Click="RefreshBrowserLink_Click"
                                                        HorizontalAlignment="Stretch" />
                                                <Button x:Name="OpenBrowserBtn"
                                                        Grid.Column="1"
                                                        Content="Open in browser"
                                                        IsEnabled="False"
                                                        HorizontalAlignment="Stretch"
                                                        Click="OpenBrowser_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Receiver controls" FontWeight="SemiBold" />
                            <TextBlock Text="Open received files or manage the local receiver service."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="ReceiverControlActions"
                                        Orientation="Vertical"
                                        Spacing="8">
                                <Button x:Name="OpenFolderBtn"
                                        Content="Open received files"
                                        HorizontalAlignment="Stretch"
                                        Click="OpenUploadFolder_Click" />
                                <Button x:Name="RestartServerBtn"
                                        Content="Restart receiver"
                                        HorizontalAlignment="Stretch"
                                        Click="RestartServer_Click" />
                                <Button x:Name="StopServerBtn"
                                        Content="Stop receiver"
                                        ToolTipService.ToolTip="Stops the receiver service started by this app."
                                        HorizontalAlignment="Stretch"
                                        Click="StopServer_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
