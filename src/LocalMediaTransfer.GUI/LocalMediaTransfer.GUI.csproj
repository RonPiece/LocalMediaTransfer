<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LocalMediaTransfer.GUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;x86;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\Icons\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <LmtEnvironment Condition="'$(LmtEnvironment)' == ''">Production</LmtEnvironment>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LmtEnvironment)' == 'Production'">
    <AssemblyName>LocalMediaTransfer.GUI</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LmtEnvironment)' == 'Test'">
    <AssemblyName>LocalMediaTransfer.GUI.Test</AssemblyName>
    <DefineConstants>$(DefineConstants);LMT_TEST_ENVIRONMENT</DefineConstants>
    <OutputPath>bin\$(Platform)\$(Configuration)-Test\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)-Test\</IntermediateOutputPath>
  </PropertyGroup>

  <Target Name="ValidateLmtEnvironment" BeforeTargets="PrepareForBuild"
          Condition="'$(LmtEnvironment)' != 'Production' and '$(LmtEnvironment)' != 'Test'">
    <Error Text="LmtEnvironment must be Production or Test." />
  </Target>

  <ItemGroup>
    <Content Include="Assets\Icons\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\AppIcon_master_1024.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Icons\TrayIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260101001" />
    <!-- MVVM Toolkit for clean architecture -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- LiveCharts for speed graphs -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.0-rc4.5" />
    <!-- QR Code generation -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalMediaTransfer.WindowsClient\LocalMediaTransfer.WindowsClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Server\static\**\*">
      <Link>static\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
