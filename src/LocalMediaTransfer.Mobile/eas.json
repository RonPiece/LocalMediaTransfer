{
  "cli": {
    "version": ">= 20.4.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_LMT_ENVIRONMENT": "test" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_LMT_ENVIRONMENT": "test" },
      "android": { "buildType": "apk" }
    },
    "android-test": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_LMT_ENVIRONMENT": "test" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_LMT_ENVIRONMENT": "production" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {}
  }
}
